{
  "realm": "dataspace",
  "enabled": true,
  "sslRequired": "none",
  "registrationAllowed": false,
  "loginWithEmailAllowed": true,
  "duplicateEmailsAllowed": false,
  "resetPasswordAllowed": true,
  "editUsernameAllowed": false,
  "bruteForceProtected": true,
  "roles": {
    "realm": [
      {
        "name": "provider",
        "description": "Data provider role - can publish datasets"
      },
      {
        "name": "consumer",
        "description": "Data consumer role - can request and access datasets"
      },
      {
        "name": "broker",
        "description": "Data broker role - can mediate transactions"
      }
    ]
  },
  "users": [
    {
      "username": "provider-user",
      "enabled": true,
      "email": "provider@dataspace.local",
      "firstName": "Provider",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "provider123",
          "temporary": false
        }
      ],
      "realmRoles": ["provider"]
    },
    {
      "username": "consumer-user",
      "enabled": true,
      "email": "consumer@dataspace.local",
      "firstName": "Consumer",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "consumer123",
          "temporary": false
        }
      ],
      "realmRoles": ["consumer"]
    },
    {
      "username": "broker-user",
      "enabled": true,
      "email": "broker@dataspace.local",
      "firstName": "Broker",
      "lastName": "User",
      "credentials": [
        {
          "type": "password",
          "value": "broker123",
          "temporary": false
        }
      ],
      "realmRoles": ["broker"]
    }
  ],
  "clients": [
    {
      "clientId": "dataspace-api",
      "enabled": true,
      "clientAuthenticatorType": "client-secret",
      "secret": "dataspace-secret",
      "redirectUris": ["*"],
      "webOrigins": ["*"],
      "protocol": "openid-connect",
      "publicClient": false,
      "serviceAccountsEnabled": true,
      "authorizationServicesEnabled": true,
      "directAccessGrantsEnabled": true,
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "fullScopeAllowed": true,
      "attributes": {
        "access.token.lifespan": "3600",
        "use.refresh.tokens": "true"
      }
    },
    {
      "clientId": "dataspace-ui",
      "enabled": true,
      "publicClient": true,
      "redirectUris": ["http://localhost:3000/*", "http://localhost:8000/*"],
      "webOrigins": ["*"],
      "protocol": "openid-connect",
      "standardFlowEnabled": true,
      "implicitFlowEnabled": false,
      "directAccessGrantsEnabled": true,
      "fullScopeAllowed": true
    }
  ]
}
