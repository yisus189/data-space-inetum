# Database
DATABASE_URL=postgresql+psycopg://dataspace_user:changeme@db:5432/dataspace

# OpenMetadata Integration (optional - uses mocks if not provided)
OPENMETADATA_URL=http://openmetadata.example.com
OPENMETADATA_API_KEY=your_api_key_here

# Keycloak Authentication
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_REALM=dataspace
KEYCLOAK_CLIENT_ID=dataspace-api
KEYCLOAK_CLIENT_SECRET=dataspace-secret

# S3/MinIO for Data Transfers
S3_ENDPOINT_URL=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin
S3_BUCKET=dataspace-transfers
S3_REGION=us-east-1

# Optional: Audit Webhook
AUDIT_WEBHOOK_URL=
