# Database Configuration
DATABASE_URL=postgresql://dataspace_user:changeme@localhost:5432/dataspace

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=dataspace
KEYCLOAK_CLIENT_ID=dataspace-client
KEYCLOAK_CLIENT_SECRET=your_secret_here

# MinIO Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=your_secret_here
MINIO_BUCKET=dataspace-transfers
MINIO_SECURE=false

# OpenMetadata Configuration
OPENMETADATA_URL=http://localhost:8585
OPENMETADATA_API_KEY=
