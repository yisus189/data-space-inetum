# Database
DATABASE_URL=postgresql://dataspace_user:changeme@db:5432/dataspace

# Keycloak / OIDC
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=myrealm
KEYCLOAK_CLIENT_ID=dataspace-ui
KEYCLOAK_CLIENT_SECRET=your_client_secret_here

# MinIO / S3 Storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin
MINIO_BUCKET=dataspace
MINIO_SECURE=false

# OpenMetadata
OPENMETADATA_URL=http://openmetadata:8585
OPENMETADATA_API_KEY=your_api_key_here

# Storage (legacy)
DATASTORE_PATH=storage

# Redis (optional)
REDIS_URL=redis://redis:6379/0

# Application
DEBUG=false
LOG_LEVEL=INFO

# JWKS Cache
JWKS_CACHE_TTL=3600

# Presigned URL Expiry (seconds)
PRESIGNED_URL_EXPIRY=3600

# EDC Integration (optional)
EDC_MANAGEMENT_URL=http://edc:8181/management
EDC_API_KEY=password
EDC_IDS_ENDPOINT=http://edc:8282/api/v1/ids
