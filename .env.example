# Variables de entorno Ejemplo
DATABASE_URL=postgres://dataspace_user:changeme@db:5432/dataspace
OPENMETADATA_URL=http://openmetadata.example.com
OPENMETADATA_API_KEY=your_api_key_here

# OIDC/Keycloak Authentication
OIDC_ISSUER=http://keycloak:8080/realms/dataspace
OIDC_AUDIENCE=dataspace-api
OIDC_JWKS_URI=http://keycloak:8080/realms/dataspace/protocol/openid-connect/certs
OIDC_JWKS_TTL=3600

# Monitoring
SENTRY_DSN=
PROMETHEUS_ENABLED=true
