# Variables de entorno Ejemplo
DATABASE_URL=postgres://dataspace_user:changeme@db:5432/dataspace
OPENMETADATA_URL=http://openmetadata.example.com
OPENMETADATA_API_KEY=your_api_key_here

# Keycloak OIDC Configuration
KEYCLOAK_SERVER_URL=https://keycloak.example.com
KEYCLOAK_REALM=dataspace
KEYCLOAK_CLIENT_ID=dataspace-client
# KEYCLOAK_AUDIENCE=dataspace-client  # Optional, uncomment if you want to validate audience
OIDC_JWKS_TTL=3600  # JWKS cache TTL in seconds
