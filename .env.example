# Variables de entorno Ejemplo
DATABASE_URL=postgres://dataspace_user:changeme@db:5432/dataspace
OPENMETADATA_URL=http://openmetadata.example.com
OPENMETADATA_API_KEY=your_api_key_here

# Keycloak OIDC Authentication
KEYCLOAK_SERVER_URL=http://keycloak:8080
KEYCLOAK_REALM=dataspace
KEYCLOAK_CLIENT_ID=dataspace-api
# KEYCLOAK_AUDIENCE=dataspace-api  # Optional - uncomment to enforce audience validation
JWKS_CACHE_TTL=3600

# Testing
# TESTING=false  # Set to true to enable test mode
