# Variables de entorno Ejemplo
DATABASE_URL=postgres://dataspace_user:changeme@db:5432/dataspace
OPENMETADATA_URL=http://openmetadata.example.com
OPENMETADATA_API_KEY=your_api_key_here

# OIDC/Keycloak Configuration
OIDC_ISSUER=https://keycloak.example.com/realms/your-realm
OIDC_AUDIENCE=data-space-api
OIDC_JWKS_URL=https://keycloak.example.com/realms/your-realm/protocol/openid-connect/certs
OIDC_JWKS_TTL=3600

# Observability
SENTRY_DSN=
PROMETHEUS_ENABLED=true
