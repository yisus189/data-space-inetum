# Database Configuration
DATABASE_URL=postgresql://dataspace_user:changeme@localhost:5432/dataspace

# OpenMetadata Configuration
OPENMETADATA_URL=http://localhost:8585
OPENMETADATA_API_KEY=

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=dataspace
KEYCLOAK_CLIENT_ID=dataspace-api
KEYCLOAK_CLIENT_SECRET=dataspace-secret

# MinIO/S3 Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minio_admin
MINIO_SECRET_KEY=minio_password
MINIO_SECURE=false
MINIO_BUCKET=dataspace-transfers

# Default Keycloak Admin Credentials (for initial setup)
# Username: kc-admin
# Password: changeMeAdmin123!

# Default Test Users (created via realm-export.json):
# Provider: provider-user / provider123
# Consumer: consumer-user / consumer123
# Broker: broker-user / broker123
