# Database Configuration
DATABASE_URL=postgresql://dataspace_user:changeme@localhost:5432/dataspace

# Keycloak Configuration
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=dataspace
KEYCLOAK_CLIENT_ID=dataspace-client
KEYCLOAK_CLIENT_SECRET=dataspace-client-secret

# Keycloak Admin Credentials (for setup only)
KEYCLOAK_ADMIN_USER=kc-admin
KEYCLOAK_ADMIN_PASSWORD=changeMeAdmin123!

# MinIO Configuration
MINIO_ENDPOINT=localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=dataspace-transfers
MINIO_SECURE=false

# OpenMetadata Configuration
OPENMETADATA_URL=http://localhost:8585
OPENMETADATA_API_KEY=

# Application Configuration
API_HOST=0.0.0.0
API_PORT=8000
LOG_LEVEL=INFO

# Development Users (for testing)
