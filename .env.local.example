# Database Configuration
DATABASE_URL=postgresql://dataspace_user:changeme@db:5432/dataspace

# OpenMetadata Configuration
OPENMETADATA_URL=http://openmetadata-server:8585
OPENMETADATA_API_KEY=your_api_key_here

# Keycloak Configuration
KEYCLOAK_URL=http://keycloak:8080
KEYCLOAK_REALM=dataspace-realm
KEYCLOAK_CLIENT_ID=dataspace-api
KEYCLOAK_CLIENT_SECRET=dataspace-client-secret

# MinIO Configuration
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
MINIO_BUCKET=dataspace-transfers
MINIO_USE_SSL=false

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
