# Development environment variables (example)
DATABASE_URL=postgres://dataspace_user:changeme@db:5432/dataspace

# Keycloak (development)
KEYCLOAK_URL=http://localhost:8080
KEYCLOAK_REALM=dataspace-realm
KEYCLOAK_CLIENT_ID=dataspace-api
KEYCLOAK_CLIENT_SECRET=dataspace-client-secret

# OIDC/JWKS settings
OIDC_JWKS_TTL=3600

# OpenMetadata (development)
OPENMETADATA_URL=http://localhost:8585
OPENMETADATA_API_KEY=

# MinIO / S3 (development)
S3_ENDPOINT=http://minio:9000
S3_ACCESS_KEY=minioadmin
S3_SECRET_KEY=minioadmin123
S3_BUCKET=dataspace-transfers

# Other
LOG_LEVEL=INFO
